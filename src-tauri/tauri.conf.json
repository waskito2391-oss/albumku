{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALBUMKU",
  "version": "0.4.0",
  "identifier": "com.antigravity.albumku",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ALBUMKU",
        "width": 1480,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}